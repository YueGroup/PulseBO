fix   1 all shake 0.0001 20 0 b 1 a 1
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
    1000 = # of frozen angles
  find clusters CPU = 0.002 seconds
fix   2 all nvt temp ${temp} ${temp} 100.0
fix   2 all nvt temp 298.15 ${temp} 100.0
fix   2 all nvt temp 298.15 298.15 100.0
fix   3 all efield  0.25 0.00 0.00   #apply electric field in the x-direction
fix   4 all momentum 100 linear 1 1 1  #remove center of mass motion

timestep	${dt}
timestep	1
thermo_style    custom step temp press etotal pe ke density lx ly lz vol
thermo          ${thermo_freq}
thermo          1000
thermo_modify   flush yes

# dumps for analysis
#First dump file with wrapped coordinates (x y z)
dump            1 all custom 1000 wrapped.lammpstrj id type x y z
dump_modify     1 sort id

# Second dump file with unwrapped coordinates and velocities
dump            2 all custom 1000 unwrapped.lammpstrj id type xu yu zu
dump_modify     2 sort id

run             ${nsteps}
run             6000000
