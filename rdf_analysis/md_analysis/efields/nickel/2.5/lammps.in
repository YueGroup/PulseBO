# SPC/E Water Simulation in LAMMPS
variable        temp equal 298.15
variable        dt equal 1.0 # units fs
variable        nsteps equal 6000000 #6ns
variable        thermo_freq equal 1000
variable        dump_freq equal 1000 

units           real
atom_style      full
boundary        p p p

log             log.lammps

# Read simulation box and atom positions
read_data       nickel.data

# Mass of each atom type
mass            1 15.9994   # Oxygen
mass            2 1.008   # Hydrogen
mass            3 58.693    #Ni
mass            4 32.06      #S
mass            5 15.9994   # Oxygen in SO4

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes 

pair_style   lj/cut/coul/long 10.0 10.0
kspace_style pppm  1e-4
pair_modify     tail yes 
pair_modify     mix arithmetic  # Lorentz–Berthelot mixing rule
bond_style      harmonic
angle_style     harmonic

# parameters for lennard jones potential
pair_coeff      1 1 0.1553        3.166   # water O-O SPC/E
pair_coeff      2 2 0.0000        0.000      # H-H
pair_coeff      3 3 0.0366       1.9495      #Ni J. Phys. Chem. A 2006, 110, 691-699
pair_coeff      4 4 0.25         3.55  #S
pair_coeff      5 5 0.20         3.15  # O in SO4

bond_coeff      1 1000.0   1.00  # O-H (water)
bond_coeff      2 250.0   1.49    # S-O 
angle_coeff     1 100.0  109.47   # H-O-H (water)
angle_coeff     2 100.0  109.47   # O-S-O 


# Initial velocity distribution
velocity        all create ${temp} 8642091 dist gaussian

min_style       cg
minimize        1e-6 1e-8 2000 20000

fix   1 all shake 0.0001 20 0 b 1 a 1
fix   2 all nvt temp ${temp} ${temp} 100.0
fix   3 all efield  0.25 0.00 0.00   #apply electric field in the x-direction
fix   4 all momentum 100 linear 1 1 1  #remove center of mass motion

timestep	${dt} 
thermo_style    custom step temp press etotal pe ke density lx ly lz vol 
thermo          ${thermo_freq} 
thermo_modify   flush yes

# dumps for analysis
#First dump file with wrapped coordinates (x y z)
dump            1 all custom 1000 wrapped.lammpstrj id type x y z
dump_modify     1 sort id

# Second dump file with unwrapped coordinates and velocities
dump            2 all custom 1000 unwrapped.lammpstrj id type xu yu zu
dump_modify     2 sort id

run             ${nsteps}

write_data equil.data

write_restart   equil.restart


