# Mass of each atom type
mass            1 15.9994   # Oxygen
mass            2 1.008   # Hydrogen
mass            3 58.9332    #Co
mass            4 32.06      #S
mass            5 15.9994   # Oxygen in SO4

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

pair_style   lj/cut/coul/long 10.0 10.0
kspace_style pppm  1e-4
pair_modify     tail yes
pair_modify     mix arithmetic  # Lorentz–Berthelot mixing rule
bond_style      harmonic
angle_style     harmonic

# parameters for lennard jones potential
pair_coeff      1 1 0.1553        3.166   # water O-O SPC/E
pair_coeff      2 2 0.0000        0.000      # H-H
pair_coeff      3 3 0.0286       2.1857      #Co
pair_coeff      4 4 0.25         3.55  #S
pair_coeff      5 5 0.20         3.15  # O in SO4

bond_coeff      1 1000.0   1.00  # O-H (water)
bond_coeff      2 250.0   1.49    # S-O
angle_coeff     1 100.0  109.47   # H-O-H (water)
angle_coeff     2 100.0  109.47   # O-S-O


# Initial velocity distribution
velocity        all create ${temp} 2984073 dist gaussian
velocity        all create 298.15 2984073 dist gaussian

min_style       cg
minimize        1e-6 1e-8 2000 20000
